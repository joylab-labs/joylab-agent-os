{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aijoylab.kr/schemas/failure_packet.schema.json",
  "title": "JoyLab Failure Packet V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "agent_id",
    "occurred_at",
    "error",
    "last_success",
    "existing_artifacts",
    "retry_possible",
    "retry_count",
    "alternative_path",
    "required_user_action"
  ],
  "properties": {
    "packet_version": {
      "const": "1.0"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "last_success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "existing_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retry_possible": {
      "type": "boolean"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "alternative_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_user_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
